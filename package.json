{
  "name": "simple-curve-counter",
  "private": true,
  "version": "0.9.0",
  "description": "Simple Curve Counter – counts left and right curves per motorcycle ride (German / English).",
  "author": "Master3307",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "sync": "pnpm build && cap sync",
    "sync:android": "pnpm build && cap sync android",
    "sync:ios": "pnpm build && cap sync ios",
    "apk": "pnpm sync:android && node scripts/build-apk.mjs",
    "apk:install": "adb install -r dist-apk/SimpleCurveCounter-latest.apk",
    "ios:open": "cap open ios",
    "icons": "capacitor-assets generate --iconBackgroundColor '#14161a' --iconBackgroundColorDark '#14161a' --splashBackgroundColor '#14161a' --splashBackgroundColorDark '#14161a'",
    "release": "node scripts/release.mjs"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/geolocation": "^8.2.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "capacitor-native-settings": "^8.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
